# Optional. Leave unset to answer by filling the official FAQ case template
# with no LLM (safest on the factory floor).
#
# Ollama example:
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=llama3.1
#
# OpenAI-compatible on-prem gateway:
#   OPENAI_BASE_URL=https://your-gateway/v1
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=your-model

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TEMPERATURE=0

# FAQ fetch API. The client calls the gateway; the gateway proxies /v1/faq here.
# Do not put Keycloak, Azure storage, SMTP, or OCR secrets in this file.
FAQ_API_PORT=7010
FAQ_API_HOST=127.0.0.1
CORS_URLS=http://localhost:5173

# Optional. Same Azure OpenAI deployment the inward service already uses.
# Set these only in the local .env, never in git.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
